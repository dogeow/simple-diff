{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Simple Diff desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "allow-commands"
  ]
}
